foreach(level IN ITEMS 0 1)
    execute_process(COMMAND "${ARGOSC}" run "${SOURCE}" "-O${level}"
        RESULT_VARIABLE vm_status_${level} OUTPUT_VARIABLE vm_output_${level} ERROR_VARIABLE error)
    if(NOT vm_status_${level} EQUAL 0)
        message(FATAL_ERROR "VM -O${level} failed: ${error}")
    endif()
    if(NATIVE)
        execute_process(COMMAND "${ARGOSC}" compile "${SOURCE}" "-O${level}" -o "${BINARY}-${level}"
            RESULT_VARIABLE status ERROR_VARIABLE error)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Native -O${level} compilation failed: ${error}")
        endif()
        execute_process(COMMAND "${BINARY}-${level}" RESULT_VARIABLE native_status_${level} OUTPUT_VARIABLE native_output_${level} ERROR_VARIABLE error TIMEOUT 5)
        if(NOT native_status_${level} EQUAL 0)
            message(FATAL_ERROR "Native -O${level} execution failed: ${error}")
        endif()
    endif()
endforeach()
if(NOT vm_output_0 STREQUAL vm_output_1)
    message(FATAL_ERROR "Optimization changed VM output")
endif()
if(NATIVE AND NOT native_output_0 STREQUAL native_output_1)
    message(FATAL_ERROR "Optimization changed native output")
endif()
