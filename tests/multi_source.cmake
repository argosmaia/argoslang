set(main "${PROJECT_ROOT}/examples/packages/client/main.argos")
set(types "${PROJECT_ROOT}/examples/packages/auth/types.argos")
execute_process(COMMAND "${ARGOSC}" run "${main}" "${types}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output STREQUAL "891\nResultado da VM: 0\n")
    message(FATAL_ERROR "Multi-source VM failed: ${result}: ${output}: ${error}")
endif()
execute_process(COMMAND "${ARGOSC}" compile "${main}" "${types}" -o "${BINARY}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Multi-source compilation failed: ${error}")
endif()
execute_process(COMMAND "${BINARY}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(NOT result EQUAL 0 OR NOT output STREQUAL "891\n")
    message(FATAL_ERROR "Multi-source native failed: ${result}: ${output}: ${error}")
endif()
file(WRITE "${BINARY}-denied.argos" "package br.argos.client;\nfunction main() -> int { var value = new br.argos.auth.TokenValidator(); return 0; }\n")
foreach(command IN ITEMS check run compile)
    execute_process(COMMAND "${ARGOSC}" "${command}" "${BINARY}-denied.argos" "${types}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT error MATCHES "ARGOS-S0630" OR NOT error MATCHES "denied.argos:2:")
        message(FATAL_ERROR "Package isolation/diagnostic failed for ${command}: ${error}")
    endif()
endforeach()
file(WRITE "${BINARY}-allowed.argos" "package br.argos.auth;\nfunction main() -> int { var value = new TokenValidator(); print(value.validate()); return 0; }\n")
execute_process(COMMAND "${ARGOSC}" run "${BINARY}-allowed.argos" "${types}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output STREQUAL "true\nResultado da VM: 0\n")
    message(FATAL_ERROR "Same-package default access failed: ${output}: ${error}")
endif()
