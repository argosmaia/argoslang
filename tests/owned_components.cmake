execute_process(COMMAND "${ARGOSC}" compile -S "${SOURCE}" -o "${BINARY}.s" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Failed to emit composition assembly: ${error}")
endif()
execute_process(COMMAND "${CC}" -x assembler-with-cpp -Dmain=argos_entry -c "${BINARY}.s" -o "${BINARY}.o" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Failed to assemble ownership test: ${error}")
endif()
execute_process(COMMAND "${CC}" "${BINARY}.o" "${WRAPPER}" -Wl,--wrap=malloc -Wl,--wrap=free -o "${BINARY}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Failed to link ownership test: ${error}")
endif()
execute_process(COMMAND "${BINARY}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Ownership cleanup failed: ${result}: ${error}")
endif()
