class Cell {
    public let number: int = 7
    public function value(_ x: int) -> int { return this.number + x; }
    public function log(_ x: int) { print(x); }
}
class Store {
    public let mut items: [int?] = [nil, 1]
}
function fetch(_ store: Store) -> Store { print("receiver"); return store; }
function offset() -> int { print("offset"); return 0; }
function effect() -> int { print("effect"); return 2; }
function identity(_ array: [int]?) -> [int]? { return array; }
function empty() -> [int] { return ([]); }
function main() -> int {
    let absent: Cell? = nil
    print(absent?.value(effect()) ?? 0)
    absent?.log(effect())
    let present: Cell? = new Cell()
    print(present?.value(effect()) ?? 0)
    present?.log(effect())
    let a: [int]? = [3, 4]
    print(identity(a)?[1]!!)
    let zero: [int] = empty()
    let b: [int]? = (nil)
    print(b?[effect()] ?? 8)
    let mut elements: [int?] = [nil, 1]
    elements[0] ??= 5
    elements[1] !!= identity(a)?[0]
    elements[0] ?= b?[0]
    print(elements[0]!!, elements[1]!!)
    let objects: [Cell]? = [new Cell()]
    print(objects?[0]?.number ?? 0)
    let texts: [string]? = ["", "hello"]
    print(texts?[0] ?== "", texts?[1] ?? "none")
    let doubles: [double]? = [1, 2.5]
    print(doubles?[0]!!)
    let inner: int? = nil
    let outer: int?? = inner
    let mut nested: int?? = nil
    nested ??= inner
    print(outer ?== nested, (outer ?? inner) ?== nil)
    let callable: (() -> int)? = nil
    print(callable ?== nil, nil ?== callable, callable == nil)
    let store = new Store()
    fetch(store).items[offset()] ??= effect()
    print(store.items[0]!!)
    let mut writable: [int]? = [1, 2]
    writable!![0] = 8
    print(writable?[0]!!)
    return 0
}
