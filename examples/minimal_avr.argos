function calculate(_ a: int, _ b: int, _ c: int, _ d: int, _ e: int, _ f: int) -> int {
    let mut result = 0
    let mut index = 0
    while index < 3 {
        result += a * b
        index++
    }
    if (c <= d && e >= f) || !(a != 2) {
        return result + (-7 % 3) + 1
    }
    return 0
}
function main() -> int {
    if calculate(2, 7, 1, 2, 4, 3) != 42 return 1
    return 0
}
