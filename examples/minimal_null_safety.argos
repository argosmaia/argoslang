class Box {
    public let mut value: int? = nil
    public let mut reads: int = 0
    public let mut writes: int = 0
    public let mut item: int? {
        getter() { this.reads += 1; return this.value; }
        setter() { this.writes += 1; this.value = value; }
    }
}
function fallback() -> int { print("fallback"); return 9; }
function index() -> int { print("index"); return 1; }
function identity(_ x: int?) -> int? { return x; }
function captured(_ x: int?) -> () -> int? { return () => x; }
function main() -> int {
    let mut number: int? = nil
    print(number ?? fallback())
    number ??= 0
    number ??= fallback()
    print(number!!, number ?== 0, number ?== nil)
    let mut target: int = 3
    target ?= identity(nil)
    print(target)
    target ?= identity(7)
    print(target)
    target !!= number
    print(target)
    let empty: int? = nil
    let nested: int?? = empty
    print(nested ?== nil, nested!! ?== nil)
    let nestedEmpty: int?? = nil
    print(nestedEmpty ?== nested)
    print(captured(4)()!!)
    let absentText: string? = (nil)
    print(absentText ?? "empty")
    let text: string? = ""
    print(text ?== "", text ?? "fallback")
    let flag: bool? = false
    print(flag!!)
    let real: double? = 1.5
    print(real!!)
    let mut box = new Box()
    box.item ??= 5
    box.item ??= fallback()
    box.item ?= identity(nil)
    box.item !!= identity(8)
    print(box.value!!, box.reads, box.writes)
    let missing: Box? = nil
    print(missing?.item ?? 10)
    let present: Box? = box
    print(present?.item ?? 0)
    let mut values: [int] = [10, 20, 30]
    values[1] = 21
    values[1] += 1
    print(values[1])
    let absent: [int]? = nil
    print(absent?[index()] ?? 99)
    let available: [int]? = values
    print(available?[index()] ?? 99)
    let optionalValues: [int?] = [nil, 4]
    let nullableValues: [int?]? = optionalValues
    print(nullableValues?[0] ?? 33)
    print(nullableValues?[1]!!)
    let optionalFunction: (() -> int?)? = captured(6)
    print(optionalFunction!!()!!)
    return 0
}
